---
profile: production

exclude_paths:
  - .github/
  - .vscode/
  - .cache/

skip_list: []

warn_list:
  - experimental

enable_list:
  - empty-string-compare
  - jinja-template-extension
  - no-log-password
  - no-prompting

mock_roles:
  - geerlingguy.pip

kinds:
  - playbook: "**/examples/*.{yml,yaml}"
  - tasks: "**/tasks/*.{yml,yaml}"
  - vars: "**/vars/*.{yml,yaml}"
  - meta: "**/meta/main.yml"
  - yaml: "**/*.{yml,yaml}"

verbosity: 1
